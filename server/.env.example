# 复制本文件为 .env 并填入真实值。.env 不要提交到 git。
PORT=3000
SITE_URL=http://localhost:3000
# 仅本地演示可设 true；生产环境禁止模拟入账。
ALLOW_DEMO_PAYMENTS=false

# PostgreSQL 连接字符串（Render 自动提供 DATABASE_URL）
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# 会话签名密钥（随便一串长随机字符串）
SESSION_SECRET=change-me-to-a-long-random-string

# 管理员账号（后台登录用；首次启动自动创建）
ADMIN_EMAIL=admin@luckybuy.local
ADMIN_PASSWORD=admin888

# 邮件发送（SMTP）。留空则验证码只打印到服务端日志（开发用）。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Lucky Buy <no-reply@luckybuy.local>

# Stripe 测试密钥（sk_test_ 开头）；必须同时配置 webhook secret。
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# 开奖提前锁定秒数（drand 未来轮次）
DRAW_LEAD_SECONDS=30

# PayPal（留空则 PayPal 通道不可用）
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=sandbox
